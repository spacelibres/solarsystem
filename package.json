{
  "name": "spacelibre-solarsystem",
  "version": "0.2.40",
  "private": true,
  "description": "Independent source reconstruction of NASA Eyes Solar System with its original UI and engine.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node eyes/scripts/dev-next.mjs",
    "prebuild": "node scripts/check-build-prereqs.mjs && node eyes/scripts/build.mjs --publish",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test --test-concurrency=2 tools/eyes-recovery.node-check.cjs tools/native-eyes.node-check.cjs tools/decoder-cache.node-check.cjs tools/eyes-analysis.node-check.cjs tools/semantic-*.node-check.cjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run eyes:check && npm run eyes:analyze:check",
    "mirror:park": "node scripts/park-mirror.mjs park",
    "mirror:restore": "node scripts/park-mirror.mjs restore",
    "eyes:recover": "node tools/recover-native-eyes.cjs",
    "test:recovery": "node --test tools/eyes-recovery.node-check.cjs tools/native-eyes.node-check.cjs",
    "eyes:build": "node eyes/scripts/build.mjs --publish",
    "eyes:check": "node eyes/scripts/audit.mjs",
    "decoders:cache": "node eyes/scripts/decoder-cache.mjs",
    "eyes:analyze": "node tools/analyze-eyes.cjs build",
    "eyes:analyze:check": "node tools/analyze-eyes.cjs check",
    "solar:catalog": "node tools/compile-solar-catalog.cjs",
    "solar:catalog:check": "node tools/compile-solar-catalog.cjs --check"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "@babel/types": "7.29.8",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.18.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.5.13",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "ws": "^8.18.0"
  }
}
