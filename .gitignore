node_modules/
.next/
out/
build/
dist/

# Local NASA asset mirror: fetched by tools/download-mirror.cjs, never committed
# (see docs/versioning.md and AGENTS.md — the library is not redistributed here).
data/mirror/

# Local artifacts and scratch
artifacts/
*.tsbuildinfo
*.log
npm-debug.log*
.DS_Store
.env
.env.*
!.env.example

# Tooling output (captured NASA research data stays out of the repo)
tools/out/

# Scratch translation chunks used while generating eyes/src/i18n/locales/*.js
.tmp-*

# De-obfuscated NASA bundles (derived from NASA code; never committed)
deobf/

# Deployment scratch (never commit host credentials or generated config)
deploy/.env

# Generated original application shell (NASA media stays remote)
public/eyes/

# Recovered source project's build output
eyes/dist/
eyes/node_modules/

# Pinned local decoder dependencies (recreated by decoders:cache)
eyes/.cache/

# Starlink header cache (rebuilt by tools/starlink/build-catalog.mjs)
.cache/

# Python authoring caches
__pycache__/
*.py[cod]
